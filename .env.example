# Copy to .env. docker compose reads it; export the DSN in your shell for the CLI.
POSTGRES_PASSWORD=change-me
FOURTHDOWN_PG_DSN=postgresql://fourthdown:change-me@127.0.0.1:5432/fourthdown

# Optional: serve the chat model from a GPU server or a hosted OpenAI-compatible API
# instead of the bundled CPU Ollama. Leave unset to use Ollama.
# FOURTHDOWN_LLM_BASE_URL=https://api.example.com/v1
# FOURTHDOWN_LLM_MODEL=model-id-at-that-endpoint
# FOURTHDOWN_LLM_API_KEY=...
