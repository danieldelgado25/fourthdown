# Copy to .env. docker compose reads it; export the DSN in your shell for the CLI.
POSTGRES_PASSWORD=change-me
FOURTHDOWN_PG_DSN=postgresql://fourthdown:change-me@127.0.0.1:5432/fourthdown

# Optional: serve the chat model from a GPU server or a hosted OpenAI-compatible API
# instead of the bundled CPU Ollama (which needs ~6 GB of RAM and minutes per answer).
# Leave unset to use Ollama. Embeddings stay on the bundled Ollama either way. E.g. Groq:
# FOURTHDOWN_LLM_BASE_URL=https://api.groq.com/openai/v1
# FOURTHDOWN_LLM_MODEL=openai/gpt-oss-120b
# FOURTHDOWN_LLM_API_KEY=...
# A hosted endpoint answers in seconds, so fail fast instead of waiting out a CPU model:
# FOURTHDOWN_LLM_TIMEOUT=45
# FOURTHDOWN_TOOL_TIMEOUT=150

# Production (docker-compose.prod.yml): the public hostname, and the dashboard login.
# Make the hash with: docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-password'
# Keep the single quotes; the hash contains '$'.
# FOURTHDOWN_DOMAIN=fourthdown.example.com
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH='$2a$14$...'
# A second login to hand out. Its questions are capped per session, per address per day,
# and in total per day; an address that floods /api/ask is blocked for a day.
# GUEST_AUTH_USER=guest
# GUEST_AUTH_HASH='$2a$14$...'
# FOURTHDOWN_GUEST_SESSION_LIMIT=15
# FOURTHDOWN_GUEST_IP_DAILY_LIMIT=40
# FOURTHDOWN_GUEST_DAILY_LIMIT=200
# FOURTHDOWN_TAG=latest
